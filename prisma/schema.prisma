datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Card {
  id                String           @id @default(cuid())
  name              String
  issuer            String
  last4             String
  type              String           @default("credit")
  statementCloseDay Int?
  paymentDueDay     Int?
  transactions      Transaction[]
  recurringRules    RecurringRule[]
  statementBalances StatementBalance[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Transaction {
  id                      String         @id @default(cuid())
  cardId                  String
  card                    Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  date                    String
  merchant                String
  amountCents             Int
  category                String
  notes                   String?
  recurringRuleId         String?
  recurringRule           RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  isRecurringGenerated    Boolean        @default(false)
  recurringOccurrenceDate String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([cardId, date])
  @@index([category])
  @@index([recurringRuleId])
}

model StatementBalance {
  id                  String   @id @default(cuid())
  cardId              String
  card                Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cycleKey            String
  cycleStartDate      String
  cycleEndDate        String
  statementTotalCents Int
  notes               String?
  paymentStatus       String   @default("pending")
  paidDate            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([cardId, cycleKey])
  @@index([cardId])
}

model RecurringRule {
  id              String        @id @default(cuid())
  merchant        String
  amountCents     Int
  category        String
  cardId          String
  card            Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  notes           String?
  frequency       String        @default("monthly")
  recurringDay    Int?
  startDate       String
  endDate         String?
  isActive        Boolean       @default(true)
  lastGeneratedAt String?
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
